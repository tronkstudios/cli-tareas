{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "webfetch": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*.env": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "uv run tareas validar*": "allow",
      "uv run tareas acciones*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "rm *": "deny",
      "cat .env*": "deny"
    }
  }
}
