# Copia este fichero como .env (o en ~/.config/tareas/.env) y rellénalo.
# .env está en .gitignore: NUNCA lo subas a git.

# API compatible con OpenAI (suele acabar en /v1)
TAREAS_IA_URL=https://ia.ejemplo/llmapi/v1
# Nombre exacto del modelo: compruébalo con  curl $TAREAS_IA_URL/models
TAREAS_IA_MODELO=nombre-del-modelo
# Tu clave personal
TAREAS_IA_CLAVE=sk-pon-aqui-tu-clave

# Opcional: certificado propio del centro (si curl dice «self-signed certificate»)
# TAREAS_IA_CA=~/.certs/centro.pem
# Opcional: segundos de espera máxima por respuesta (por defecto 180)
# TAREAS_IA_ESPERA=180
